---
import Layout from '@/layouts/Layout.astro';

const TITLE = 'Reader — turn saved sources into working knowledge';
const DESCRIPTION =
  'A personal research library for capturing articles and PDFs, reading without distractions, annotating evidence, and revisiting what matters.';

const loop = [
  {
    number: '01',
    title: 'Capture the source',
    body: 'Paste an article URL or upload a PDF. Reader keeps the source and prepares it for focused reading.',
  },
  {
    number: '02',
    title: 'Read without the page',
    body: 'Web clutter falls away. The text, document structure, reading controls, and your place remain.',
  },
  {
    number: '03',
    title: 'Mark what matters',
    body: 'Highlight the exact passage, leave a note beside it, or listen when reading is not practical.',
  },
  {
    number: '04',
    title: 'Find the thought again',
    body: 'Search the library, return through tags and lists, arrange a board, or question the open source with AI.',
  },
];

const capabilities = [
  [
    'Sources',
    'Web articles and PDFs live in the same library. PDF text is extracted for search and source-grounded discussion.',
  ],
  [
    'Reading',
    'A typography-first view keeps highlights, notes, reading progress, and text-to-speech beside the source.',
  ],
  [
    'Retrieval',
    'Full-text search, tags, lists, and boards give the same source more than one useful way back in.',
  ],
  [
    'Assistance',
    'Summaries and chat work over material you chose. Reader supports the Fleet gateway or browser-held BYOK keys.',
  ],
  [
    'Feeds',
    'Authenticated readers can import OPML and refresh RSS or Atom feeds manually, then save an item into the library.',
  ],
  [
    'Portability',
    'Account data can be exported as JSON. Public sharing is an explicit action, not the default state.',
  ],
];
---

<Layout title={TITLE} description={DESCRIPTION}>
  <div class="page">
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Reader home">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span>Reader</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="#loop">The loop</a>
          <a href="#library">Library</a>
          <a href="#boundary">Current state</a>
          <a href="/faq">FAQ</a>
          <a href="/changelog">Changelog</a>
        </nav>
        <a class="btn-signin" href="/login">Sign in</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><span aria-hidden="true">✦</span> Personal research library</p>
          <h1>Turn the things you save into things you can use.</h1>
          <p class="hero-lede">
            Reader is for people who save serious articles and PDFs, then lose them among browser
            tabs and undifferentiated bookmarks. It gives each source a quiet place to read, mark,
            question, and find again.
          </p>
          <div class="cta-row">
            <a class="btn-primary" href="/library">Open Reader <span aria-hidden="true">↗</span></a>
            <a class="btn-secondary" href="/sample">Try a sample document</a>
          </div>
          <ul class="truth-row" aria-label="Current product state">
            <li>Browser-local start</li>
            <li>Google sign-in for the account library</li>
            <li>No checkout</li>
          </ul>
        </div>

        <div class="reader-window" aria-label="Illustration of Reader's article and annotation view">
          <div class="window-bar">
            <span class="window-label"><i aria-hidden="true"></i> reader / systems</span>
            <span>8 min left</span>
          </div>
          <div class="window-grid">
            <aside class="source-rail" aria-label="Example source list">
              <span class="rail-heading">Research set</span>
              <span class="rail-item is-active"><b>01</b> Durable systems</span>
              <span class="rail-item"><b>02</b> Interface memory</span>
              <span class="rail-item"><b>03</b> Trust signals</span>
              <span class="rail-count">3 sources · 7 notes</span>
            </aside>
            <article class="article-sheet">
              <p class="article-kicker">Saved article · 14 min</p>
              <h2>How durable systems earn trust</h2>
              <p class="article-byline">A working excerpt for interface demonstration</p>
              <p>
                A useful research system does not ask you to remember where the evidence lived. It
                keeps the source close enough to inspect again.
              </p>
              <p class="highlighted">
                The goal is not a larger reading list. It is a shorter distance between a claim,
                the passage behind it, and the note you made while thinking.
              </p>
              <p>
                That distance becomes the difference between collecting material and building
                understanding from it.
              </p>
            </article>
            <aside class="margin-notes" aria-label="Example annotation panel">
              <div class="note-tabs"><span class="is-active">Notes</span><span>Ask</span></div>
              <div class="margin-note">
                <span>NOTE 04</span>
                <p>Evidence and interpretation should stay adjacent.</p>
              </div>
              <div class="ask-box">
                <span>Ask this source</span>
                <p>Where does the author separate collection from understanding?</p>
                <b>↵</b>
              </div>
            </aside>
          </div>
          <p class="window-caption">Illustrative interface — example text, not a customer document.</p>
        </div>
      </section>

      <section class="proof-strip" aria-label="Reader product summary">
        <p><span>Input</span> Article URL or PDF</p>
        <p><span>Working surface</span> Text, highlights, notes, audio</p>
        <p><span>Way back</span> Search, tags, lists, boards</p>
        <p><span>Default</span> Private</p>
      </section>

      <section id="loop" class="section loop-section">
        <div class="section-heading">
          <p class="section-index">01 / THE READING LOOP</p>
          <h2>A saved tab is only an intention.</h2>
          <p>
            Reader earns its place after “save.” The product carries one source through attentive
            reading and back into reach when the thought becomes useful.
          </p>
        </div>
        <ol class="loop-grid">
          {loop.map((step) => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="library" class="section library-section">
        <div class="section-heading compact">
          <p class="section-index">02 / ONE WORKING LIBRARY</p>
          <h2>Keep the source, the mark, and the next question together.</h2>
        </div>
        <div class="library-ledger">
          {capabilities.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section evidence-section">
        <div class="evidence-quote">
          <p class="section-index">03 / WHY IT EXISTS</p>
          <blockquote>“I wanted any article or PDF to become a focused reading and research surface instead of another forgotten browser tab.”</blockquote>
          <cite>— Product maker note</cite>
        </div>
        <div class="evidence-list">
          <p><span>Capture</span> Mozilla Readability prepares saved web pages; PDF uploads join the same library.</p>
          <p><span>Evidence</span> Highlights remain anchored to the passage that prompted them.</p>
          <p><span>Return</span> Search and organisation operate over the material and notes already saved.</p>
          <p><span>Scope</span> There is no social feed, recommendation engine, or paid team workspace.</p>
        </div>
      </section>

      <section id="boundary" class="section boundary-section">
        <div class="section-heading compact">
          <p class="section-index">04 / CURRENT BOUNDARY</p>
          <h2>Maintained for real use, not expansion for its own sake.</h2>
          <p>
            Reader is a mature personal-use product in maintenance-first support. The owner is not
            using it enough to justify speculative features, so future work is limited to problems
            that block the capture-to-reading loop.
          </p>
        </div>
        <div class="boundary-grid">
          <article>
            <p class="boundary-label">Without an account</p>
            <h3>Start in this browser.</h3>
            <p>Use the device-local path to capture and read without creating a Reader account.</p>
          </article>
          <article>
            <p class="boundary-label">With Google sign-in</p>
            <h3>Open the account-backed library.</h3>
            <p>Saved material is isolated per user; PDFs are stored behind an ownership-enforcing proxy.</p>
          </article>
          <article>
            <p class="boundary-label">Companion tooling</p>
            <h3>The extension is source-built, not publicly distributed.</h3>
            <p>The MV3 companion exists for local unpacked installs. A public browser-store release is deferred.</p>
          </article>
          <article>
            <p class="boundary-label">Commercial state</p>
            <h3>No public plan or checkout.</h3>
            <p>The repository does not establish a permanent free promise or a paid offer, so this page invents neither.</p>
          </article>
        </div>
      </section>

      <section class="faq-preview">
        <div>
          <p class="section-index">05 / PRACTICAL QUESTIONS</p>
          <h2>Before you put a source inside.</h2>
        </div>
        <div class="faq-list">
          <details class="faq-item">
            <summary>Does Reader publish what I save?</summary>
            <p>No. Libraries are private by default. A shared article or board requires an explicit share action.</p>
          </details>
          <details class="faq-item">
            <summary>What does AI see?</summary>
            <p>AI features operate on the material you open and ask about. Browser-held BYOK credentials are used per request and are not stored server-side.</p>
          </details>
          <details class="faq-item">
            <summary>Can I install the Chrome extension?</summary>
            <p>The extension is currently available from source for local unpacked installation. Public browser-store distribution is deferred.</p>
          </details>
          <details class="faq-item">
            <summary>Can I take my data out?</summary>
            <p>Yes. Reader includes a JSON export for account-scoped articles, boards, and lists.</p>
          </details>
        </div>
        <a class="text-link" href="/faq">Read the complete FAQ <span aria-hidden="true">→</span></a>
      </section>

      <section class="closing">
        <div class="closing-inner">
          <p class="section-index">OPEN THE LIBRARY</p>
          <h2>Bring one source you mean to understand.</h2>
          <p>Start in this browser, or sign in with Google for the account-backed library.</p>
          <div class="cta-row centered">
            <a class="btn-primary" href="/library">Open Reader <span aria-hidden="true">↗</span></a>
            <a class="btn-secondary" href="/sample">Try the sample</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">R</span><span>Reader</span></a>
        <p>A maintained personal research library for turning saved sources into working knowledge.</p>
      </div>
      <div class="footer-state">
        <span>Current state</span>
        <p>Personal-use · maintenance-first · no public checkout</p>
      </div>
      <nav aria-label="Footer">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/changelog">Changelog</a>
        <a href="https://github.com/Significant-Hobbies/reader/issues">Roadmap</a>
        <a href="https://github.com/Significant-Hobbies/reader">Source</a>
      </nav>
    </footer>
  </div>
</Layout>
