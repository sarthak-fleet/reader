---
import Layout from '@/layouts/Layout.astro';

const repository = 'https://github.com/Significant-Hobbies/reader';
const releases = [
  {
    date: '2026-07-13',
    title: 'RSS and Atom reading joined the library',
    outcomes: [
      'Authenticated readers can import OPML, add or remove feeds, refresh them on demand, and track unread items.',
      'A feed item can be saved directly into the same article and PDF library for annotation and later research.',
    ],
  },
  {
    date: '2026-07-03',
    title: 'Memory capture became durable',
    outcomes: [
      'Saved research memories gained authenticated persistence, search, and a dedicated reading surface.',
      'Existing browser memories can be imported into the account-backed collection.',
    ],
  },
  {
    date: '2026-07-02',
    title: 'Safer failure recovery',
    outcomes: [
      'Unhandled API and Worker errors now return a controlled response instead of breaking the request path.',
      'A React error boundary gives the library a recovery surface when a page fails to render.',
    ],
  },
  {
    date: '2026-06-20',
    title: 'Reader moved to a faster app shell',
    outcomes: [
      'The product moved to a Vite and React SPA backed by a focused Hono Worker while preserving its production identity.',
      'Articles, PDFs, highlights, notes, boards, lists, search, and AI-assisted reading stayed together in one library.',
    ],
  },
];
---

<Layout
  title="Reader changelog — meaningful product improvements"
  description="Verified improvements to Reader’s capture, reading, annotation, retrieval, and reliability workflows."
  canonicalPath="/changelog"
>
  <div class="page">
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span>Reader</span>
        </a>
        <nav class="nav-links" aria-label="Site">
          <a href="/#loop">The loop</a>
          <a href="/#library">Library</a>
          <a href="/faq">FAQ</a>
          <a aria-current="page" href="/changelog">Changelog</a>
        </nav>
        <a class="btn-signin" href="/login">Sign in</a>
      </div>
    </header>

    <main class="changelog-main">
      <header class="changelog-header">
        <span class="eyebrow">Product history</span>
        <h1>Changelog</h1>
        <p>
          Verified improvements to saving, reading, annotating, and returning to useful sources.
        </p>
        <nav aria-label="Project links">
          <a href={`${repository}/issues`}>Roadmap</a>
          <a
            href={repository}
            aria-label="GitHub repository"
            title="GitHub repository"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-github-link"
            ><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"
              ><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            ></a
          >
        </nav>
      </header>

      <ol class="changelog-list">
        {
          releases.map((release) => (
            <li>
              <article class="changelog-entry">
                <time datetime={release.date}>
                  {new Date(`${release.date}T00:00:00`).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <h2>{release.title}</h2>
                <ul>
                  {release.outcomes.map((outcome) => <li>{outcome}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
      </ol>
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">R</span><span>Reader</span></a>
        <p>A maintained personal research library for turning saved sources into working knowledge.</p>
      </div>
      <div class="footer-state">
        <span>Current state</span>
        <p>Personal-use · maintenance-first · no public checkout</p>
      </div>
      <nav aria-label="Footer">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/faq">FAQ</a>
        <a href={`${repository}/issues`}>Roadmap</a>
        <a
          href={repository}
          aria-label="GitHub repository"
          title="GitHub repository"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-github-link"
          ><svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"
            ><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          ></a
        >
      </nav>
    </footer>
  </div>
</Layout>
