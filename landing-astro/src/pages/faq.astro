---
import Layout from '@/layouts/Layout.astro';

const TITLE = 'Reader FAQ — sources, privacy, AI, and current access';
const DESCRIPTION =
  'Answers about saving articles and PDFs in Reader, local and account-backed use, annotations, AI, sharing, export, and the source-built extension.';

const faqs = [
  {
    q: 'What is Reader for?',
    a: 'Reader turns a saved article or PDF into a focused place to read, annotate, revisit, and discuss it. It is useful when a browser tab or bookmark is too easy to forget and the source deserves more deliberate attention.',
  },
  {
    q: 'What can I save?',
    a: 'Paste a web article URL or upload a PDF. Reader uses Mozilla Readability to prepare web pages for a cleaner reading view, while PDF text is extracted so the document can join the same search and discussion flow.',
  },
  {
    q: 'Do I need an account?',
    a: 'No account is required to start with the browser-local path. Google sign-in opens the account-backed library, where saved material is isolated per user and PDFs are stored behind an ownership-enforcing proxy.',
  },
  {
    q: 'How do highlights and notes work?',
    a: 'Select a passage in the reader view to highlight it or add a note. Reader keeps the annotation anchored to the text that prompted it, so the source and your interpretation remain close when you return.',
  },
  {
    q: 'How does AI work in Reader?',
    a: 'Reader can summarize an open article or PDF and answer questions about it. The app supports the Fleet AI gateway and bring-your-own OpenAI, Anthropic, or Gemini credentials. BYOK credentials are held in the browser, used for the request, and not persisted server-side.',
  },
  {
    q: 'Is my library public?',
    a: 'No. Saved articles, PDFs, annotations, lists, boards, and AI conversations are private by default. Reader creates a public surface only when you explicitly share an article or board.',
  },
  {
    q: 'Can I install the Chrome extension?',
    a: 'The MV3 companion exists in the source repository and can be loaded as an unpacked extension for local use. Public browser-store distribution is deferred, so the landing page does not present it as a generally available install.',
  },
  {
    q: 'Can I organize and retrieve older material?',
    a: 'Yes. Full-text search covers saved sources and notes. Tags provide cross-cutting labels, lists group related material, and boards help arrange a research set or reading stage.',
  },
  {
    q: 'Can I export my data?',
    a: 'Yes. Reader includes a JSON export for the articles, boards, and lists scoped to the signed-in account.',
  },
  {
    q: 'Is Reader a paid product?',
    a: 'There is currently no public Reader plan or checkout. The repository also does not establish a permanent free promise, so the product page states the present access model without inventing future pricing.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<Layout title={TITLE} description={DESCRIPTION} canonicalPath="/faq">
  <div class="page">
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Reader home">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span>Reader</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href="/#loop">The loop</a>
          <a href="/#library">Library</a>
          <a href="/#boundary">Current state</a>
          <a aria-current="page" href="/faq">FAQ</a>
          <a href="/changelog">Changelog</a>
        </nav>
        <a class="btn-signin" href="/login">Sign in</a>
      </div>
    </header>

    <main class="faq-page">
      <header class="faq-page-header">
        <p class="section-index">Reader / Practical questions</p>
        <h1>What happens to a source after you bring it inside?</h1>
        <p>
          The useful details about capture, privacy, AI, organisation, sharing, export, and the
          current product boundary.
        </p>
      </header>

      <h2 class="faq-list-title">Reader questions and answers</h2>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>

      <div class="cta-row">
        <a class="btn-primary" href="/library">Open Reader <span aria-hidden="true">↗</span></a>
        <a class="btn-secondary" href="/sample">Try a sample document</a>
      </div>
    </main>

    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/"><span class="brand-mark" aria-hidden="true">R</span><span>Reader</span></a>
        <p>A maintained personal research library for turning saved sources into working knowledge.</p>
      </div>
      <div class="footer-state">
        <span>Current state</span>
        <p>Personal-use · maintenance-first · no public checkout</p>
      </div>
      <nav aria-label="Footer">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/changelog">Changelog</a>
        <a href="https://github.com/Significant-Hobbies/reader/issues">Roadmap</a>
        <a href="https://github.com/Significant-Hobbies/reader">Source</a>
      </nav>
    </footer>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</Layout>
